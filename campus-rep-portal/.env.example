SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True # Local development only; set DEBUG=False in production.
ALLOWED_HOSTS=localhost,127.0.0.1
# Local development only. Production defaults to HTTPS redirects when DEBUG=False.
SECURE_SSL_REDIRECT=False
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
VAPID_PRIVATE_KEY=replace-with-your-vapid-private-key
VAPID_PUBLIC_KEY=replace-with-your-vapid-public-key
DATABASE_URL=sqlite:///db.sqlite3
# Local development values. Production defaults target the Vercel homepage unless overridden.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
# Production:
# WEBAUTHN_RP_ID=campus-pulse-gules-iota.vercel.app
# WEBAUTHN_ORIGIN=https://campus-pulse-gules-iota.vercel.app
# CORS_ALLOWED_ORIGINS=https://campus-pulse-gules-iota.vercel.app
# CSRF_TRUSTED_ORIGINS=https://campus-pulse-gules-iota.vercel.app
